# ---- Server ----
NODE_ENV=development
PORT=4500
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5500,http://localhost:5501

# ---- Database (MongoDB) ----
MONGODB_URI=mongodb+srv://emmanuel90px_db_user:Y2fzluUZ0aUhEyvT@cluster0.prikxmo.mongodb.net/


# ---- Auth ----
JWT_ACCESS_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=replace_with_another_unique_random_secret_of_at_least_32_characters
# Use "none" only when the storefront and API are on different sites; HTTPS is required.
COOKIE_SAME_SITE=lax

# ---- Production owner account (created on startup) ----
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace_with_a_unique_password_of_at_least_12_characters
OWNER_USERNAME=admin
OWNER_NAME=Store Owner
OWNER_FORCE_PASSWORD_RESET=false

# ---- File storage ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# ---- AI Try-On provider ----
# The AI Studio module calls out to whatever image-generation provider you use.
# Set the base URL + key for that provider here; see src/modules/aiStudio/aiProvider.js
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
